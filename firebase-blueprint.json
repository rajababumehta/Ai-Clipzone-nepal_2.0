{
  "entities": {
    "CourseRequest": {
      "title": "CourseRequest",
      "description": "Represents a student's access request for a premium AI course",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Authentication UID of the student"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "The email address of the student"
        },
        "courseId": {
          "type": "string",
          "description": "The custom string ID of the course requested"
        },
        "courseTitle": {
          "type": "string",
          "description": "The title of the requested course"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined"],
          "description": "The current verification and activation status of the request"
        },
        "requestedAt": {
          "type": "number",
          "description": "The timestamp when the request was made"
        }
      },
      "required": ["userId", "userEmail", "courseId", "courseTitle", "status", "requestedAt"]
    },
    "ActivationKey": {
      "title": "ActivationKey",
      "description": "Represents a generated unique subscription license key/code",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "The unique code like AI45NP"
        },
        "activeDeviceId": {
          "type": "string",
          "description": "The ID of the device currently active with this code for single-device restriction"
        },
        "status": {
          "type": "string",
          "enum": ["unused", "used"],
          "description": "Whether the key has been claimed"
        },
        "duration": {
          "type": "string",
          "enum": ["1month", "1year"],
          "description": "Duration of the license"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when key was created"
        },
        "claimedByEmail": {
          "type": "string",
          "format": "email",
          "description": "The email of the student who claimed the key"
        },
        "claimedByUid": {
          "type": "string",
          "description": "The Firebase Auth UID of the student who claimed the key"
        },
        "claimedAt": {
          "type": "number",
          "description": "Timestamp when the key was claimed"
        },
        "expiresAt": {
          "type": "number",
          "description": "Timestamp when the license expires"
        },
        "courseId": {
          "type": "string",
          "description": "The course ID associated with this activation key"
        },
        "courseTitle": {
          "type": "string",
          "description": "The title of the course associated with this activation key"
        },
        "createdByRole": {
          "type": "string",
          "enum": ["main_admin", "sub_admin"],
          "description": "Whether the key was generated by the Main Admin or a course-scoped Sub-Admin"
        },
        "createdBySubAdminCode": {
          "type": "string",
          "description": "The secret code of the Sub-Admin who generated this key, if applicable"
        },
        "createdByName": {
          "type": "string",
          "description": "Display name of the Sub-Admin who generated this key"
        },
        "studentName": {
          "type": "string",
          "description": "Student name assigned to this activation key"
        },
        "studentAvatar": {
          "type": "string",
          "description": "Saved profile photo or logo data URI/URL for the student"
        }
      },
      "required": ["code", "status", "duration", "createdAt"]
    },
    "SubAdminAccount": {
      "title": "SubAdminAccount",
      "description": "Course-scoped Sub-Admin credentials created by the Main Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "description": "Unique Sub-Admin login secret code (e.g. SUB-XXXXXX)" },
        "name": { "type": "string", "description": "Display label/name for the Sub-Admin" },
        "courseId": { "type": "string", "description": "The single course ID this Sub-Admin is permitted to manage" },
        "courseTitle": { "type": "string", "description": "The title of the assigned course" },
        "avatarUrl": { "type": "string", "description": "Custom logo or profile image URL/data URI for the Sub-Admin" },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lastLoginAt": { "type": "number" },
        "activeDeviceId": { "type": "string" }
      },
      "required": ["code", "name", "courseId", "courseTitle", "status", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Represents a dynamic course offered by AI Clipzone",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique course slug ID"
        },
        "title": {
          "type": "string",
          "description": "The title of the course"
        },
        "price": {
          "type": "string",
          "description": "The displayed price tag of the course"
        },
        "amount": {
          "type": "number",
          "description": "Numerical price value for calculation"
        },
        "message": {
          "type": "string",
          "description": "Suffix message for WhatsApp purchases"
        },
        "learn": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Key learn highlights of the course"
        },
        "image": {
          "type": "string",
          "description": "URL to the course display thumbnail"
        },
        "isPopular": {
          "type": "boolean",
          "description": "Whether this is marked as a popular bestseller"
        },
        "popularText": {
          "type": "string",
          "description": "Display banner text for popular courses"
        },
        "hasLiveSessions": {
          "type": "boolean",
          "description": "Whether Zoom live classes are included in this course"
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "duration": { "type": "string" },
              "videoUrl": { "type": "string" }
            },
            "required": ["title", "duration", "videoUrl"]
          },
          "description": "List of instructional videos in this course"
        },
        "paymentConfig": {
          "type": "object",
          "description": "Optional per-course payment QR, eSewa, bank, and WhatsApp override"
        }
      },
      "required": ["id", "title", "price", "amount", "message", "learn", "image", "videos"]
    },
    "PaymentQrConfig": {
      "title": "PaymentQrConfig",
      "description": "System payment QR code, eSewa ID, bank and payment checkout configuration",
      "type": "object",
      "properties": {
        "esewaId": { "type": "string" },
        "accountName": { "type": "string" },
        "bankName": { "type": "string" },
        "bankAccountNo": { "type": "string" },
        "bankBranch": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "qrImageUrl": { "type": "string" },
        "paymentInstruction": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["esewaId", "accountName", "whatsappNumber"]
    },
    "FAQConfig": {
      "title": "FAQConfig",
      "description": "Dynamic FAQs collection and questions list configuration",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" }
            },
            "required": ["question", "answer"]
          }
        },
        "updatedAt": { "type": "number" }
      },
      "required": ["items"]
    },
    "SiteSettingsConfig": {
      "title": "SiteSettingsConfig",
      "description": "Global website banner, contact info, institute branding, logo URLs, and certificate design & signatures",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string" },
        "siteTagline": { "type": "string" },
        "instituteName": { "type": "string" },
        "instituteLogoUrl": { "type": "string" },
        "noticeBannerText": { "type": "string" },
        "showNoticeBanner": { "type": "boolean" },
        "supportEmail": { "type": "string" },
        "supportPhone": { "type": "string" },
        "certificateTitle": { "type": "string" },
        "certificateSubtitle": { "type": "string" },
        "certificateInstituteName": { "type": "string" },
        "certificateLogoUrl": { "type": "string" },
        "certificateDescription": { "type": "string" },
        "certificateDirectorName": { "type": "string" },
        "certificateDirectorTitle": { "type": "string" },
        "certificateDirectorSignatureUrl": { "type": "string" },
        "certificateCeoName": { "type": "string" },
        "certificateCeoTitle": { "type": "string" },
        "certificateCeoSignatureUrl": { "type": "string" },
        "certificateTheme": { "type": "string" },
        "certificateStampUrl": { "type": "string" },
        "certificateSealText": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    },
    "SupportConversation": {
      "title": "SupportConversation",
      "description": "Represents a role-isolated support conversation (Sub-Admin <-> Student or Main Admin <-> Sub-Admin)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userAvatar": { "type": "string" },
        "channelType": { "type": "string", "enum": ["student_mainadmin", "student_subadmin", "subadmin_mainadmin"] },
        "subAdminCode": { "type": "string" },
        "subAdminName": { "type": "string" },
        "courseId": { "type": "string" },
        "activeCourse": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "number" },
        "lastSender": { "type": "string" },
        "unreadAdminCount": { "type": "number" },
        "unreadUserCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "clearedByUserAt": { "type": "number" },
        "clearedByAdminAt": { "type": "number" }
      },
      "required": ["userId", "userName", "lastMessage", "lastMessageAt"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "A single chat message in a support conversation",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "sender": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["conversationId", "sender", "senderName", "text", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "Registered AI Clipzone student or admin profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["student", "sub_admin", "main_admin"] },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Verified student course enrollment record linked to payment/activation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string", "format": "email" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "activationCode": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "revoked"] },
        "enrolledAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["userId", "courseId", "status", "enrolledAt"]
    },
    "LiveClass": {
      "title": "LiveClass",
      "description": "Publicly visible live class schedule metadata without Zoom secrets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "instructorName": { "type": "string" },
        "scheduledStartAt": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "scheduledEndAt": { "type": "number" },
        "maxCapacity": { "type": "number" },
        "registeredCount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published", "live", "completed", "cancelled"] },
        "joinWindowMinutesBefore": { "type": "number" },
        "zoomCreated": { "type": "boolean" },
        "zoomMeetingStatus": { "type": "string", "enum": ["created", "failed", "pending"] },
        "zoomMeetingIdMasked": { "type": "string" },
        "zoomError": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "sendReminder30m": { "type": "boolean" },
        "sendReminder5m": { "type": "boolean" },
        "reminder30mSent": { "type": "boolean" },
        "reminder5mSent": { "type": "boolean" },
        "publishedAt": { "type": "number" },
        "createdBy": { "type": "string" },
        "createdByRole": { "type": "string", "enum": ["main_admin", "sub_admin"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "courseId", "courseTitle", "title", "scheduledStartAt", "durationMinutes", "maxCapacity", "registeredCount", "status", "createdAt"]
    },
    "LiveClassRegistration": {
      "title": "LiveClassRegistration",
      "description": "Atomic seat reservation / attendance entry for an enrolled student",
      "type": "object",
      "properties": {
        "liveClassId": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string", "format": "email" },
        "activationCode": { "type": "string" },
        "courseId": { "type": "string" },
        "status": { "type": "string", "enum": ["registered", "joined"] },
        "registeredAt": { "type": "number" },
        "joinedAt": { "type": "number" }
      },
      "required": ["liveClassId", "userId", "courseId", "status", "registeredAt"]
    },
    "LiveClassSecret": {
      "title": "LiveClassSecret",
      "description": "Server-only Zoom meeting ID, passcode, join URL, and host start URL",
      "type": "object",
      "properties": {
        "liveClassId": { "type": "string" },
        "zoomMeetingId": { "type": "string" },
        "zoomPasscode": { "type": "string" },
        "zoomJoinUrl": { "type": "string" },
        "zoomStartUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["liveClassId", "zoomMeetingId", "zoomPasscode", "zoomJoinUrl"]
    },
    "PushNotification": {
      "title": "PushNotification",
      "description": "In-app and PWA push notification item for students",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["discount", "welcome", "announcement", "course", "general", "live_class", "live_reminder"] },
        "badge": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "number" },
        "author": { "type": "string" },
        "target": { "type": "string", "enum": ["all", "students", "course_enrolled"] },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "liveClassId": { "type": "string" },
        "deliveryKey": { "type": "string" },
        "reminderType": { "type": "string", "enum": ["published", "30m", "5m", "manual"] }
      },
      "required": ["title", "body", "type", "createdAt"]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "Server-verified FCM device push registration bound to verified course enrollments",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "deviceId": { "type": "string" },
        "enrolledCourseIds": { "type": "array", "items": { "type": "string" } },
        "platform": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["token", "userId", "enrolledCourseIds", "updatedAt"]
    },
    "NotificationDelivery": {
      "title": "NotificationDelivery",
      "description": "Idempotency lock document preventing duplicate live class notifications and reminders",
      "type": "object",
      "properties": {
        "deliveryKey": { "type": "string" },
        "liveClassId": { "type": "string" },
        "courseId": { "type": "string" },
        "reminderType": { "type": "string", "enum": ["published", "30m", "5m"] },
        "createdAt": { "type": "number" }
      },
      "required": ["deliveryKey", "liveClassId", "reminderType", "createdAt"]
    }
  },
  "firestore": {
    "course_requests/{requestId}": {
      "schema": "CourseRequest",
      "description": "Collection tracking student payment and activation course requests"
    },
    "activation_keys/{code}": {
      "schema": "ActivationKey",
      "description": "Collection tracking subscription activation codes"
    },
    "courses/{courseId}": {
      "schema": "Course",
      "description": "Collection tracking dynamic courses available for enrollment"
    },
    "system/payment_qr": {
      "schema": "PaymentQrConfig",
      "description": "Document holding dynamic payment QR and checkout credentials"
    },
    "system/faqs": {
      "schema": "FAQConfig",
      "description": "Document holding dynamic FAQs list"
    },
    "system/site_settings": {
      "schema": "SiteSettingsConfig",
      "description": "Document holding global website branding and settings"
    },
    "support_conversations/{conversationId}": {
      "schema": "SupportConversation",
      "description": "Collection of student support threads"
    },
    "support_conversations/{conversationId}/messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Real-time messages between student and admin"
    },
    "sub_admins/{code}": {
      "schema": "SubAdminAccount",
      "description": "Collection of course-scoped sub-admin accounts managed by the Main Admin"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Registered student or admin user profile"
    },
    "enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Verified student course enrollment records"
    },
    "liveClasses/{classId}": {
      "schema": "LiveClass",
      "description": "Live class schedule metadata (public-safe, no Zoom credentials)"
    },
    "liveClasses/{classId}/registrations/{registrationId}": {
      "schema": "LiveClassRegistration",
      "description": "Capacity-controlled student seat reservations for live classes"
    },
    "liveClassSecrets/{classId}": {
      "schema": "LiveClassSecret",
      "description": "Backend-only Zoom meeting IDs, passcodes, and URLs (blocked from all clients)"
    },
    "notifications/{notificationId}": {
      "schema": "PushNotification",
      "description": "Notification history for announcements and course-scoped live class alerts"
    },
    "fcmTokens/{tokenId}": {
      "schema": "FcmToken",
      "description": "Registered FCM Web Push / PWA device tokens"
    },
    "notificationDeliveries/{deliveryKey}": {
      "schema": "NotificationDelivery",
      "description": "Server-side deduplication locks for live class publish & reminder notifications"
    }
  }
}

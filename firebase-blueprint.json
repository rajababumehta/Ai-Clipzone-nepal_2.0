{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted Main Administrator grant keyed by Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["main_admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "role"]
    },
    "CourseRequest": {
      "title": "CourseRequest",
      "description": "Represents a student's access request for a premium AI course",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\- ]+$" },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "requestedAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "duration": { "type": "string", "enum": ["1month", "1year"] }
      },
      "required": ["userId", "userEmail", "courseId", "courseTitle", "status", "requestedAt"]
    },
    "ActivationKey": {
      "title": "ActivationKey",
      "description": "Represents a generated unique single-device subscription license key/code",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["unused", "used", "expired", "deleted"] },
        "duration": { "type": "string", "enum": ["1day", "1month", "1year"] },
        "createdAt": { "type": "number" },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\- ]+$" },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "studentName": { "type": "string", "maxLength": 120 },
        "claimedByName": { "type": "string", "maxLength": 120 },
        "claimedByEmail": { "type": "string", "maxLength": 200 },
        "claimedByUid": { "type": "string", "maxLength": 128 },
        "originalOwnerUid": { "type": "string", "maxLength": 128 },
        "claimedAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "activeDeviceId": { "type": "string", "maxLength": 128 },
        "deviceClaimedAt": { "type": "number" },
        "forceLogoutAt": { "type": "number" },
        "studentAvatar": { "type": "string", "maxLength": 350000 },
        "studentAvatarUpdatedAt": { "type": "number" },
        "createdByRole": { "type": "string", "enum": ["main_admin", "sub_admin"] },
        "createdBySubAdminCode": { "type": "string", "maxLength": 64 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "subAdminUid": { "type": "string", "maxLength": 128 },
        "isExpired": { "type": "boolean" }
      },
      "required": ["code", "status", "duration", "createdAt"]
    },
    "SubAdminAccount": {
      "title": "SubAdminAccount",
      "description": "Course-scoped Sub-Admin credentials created by Main Admin (restricted from public listing)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "publicProfileId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\- ]+$" },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "avatarUrl": { "type": "string", "maxLength": 350000 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "activeUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lastLoginAt": { "type": "number" },
        "activeDeviceId": { "type": "string", "maxLength": 128 }
      },
      "required": ["code", "name", "courseId", "courseTitle", "status", "createdAt"]
    },
    "SubAdminPublicProfile": {
      "title": "SubAdminPublicProfile",
      "description": "Public non-secret routing directory for course instructors (never contains Sub-Admin login code)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\- ]+$" },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 120 },
        "avatarUrl": { "type": "string", "maxLength": 350000 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "activeUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "courseId", "courseTitle", "name", "status"]
    },
    "Course": {
      "title": "Course",
      "description": "Dynamic course offered on the LMS platform",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\- ]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "price": { "type": "string", "maxLength": 64 },
        "amount": { "type": "number" },
        "message": { "type": "string", "maxLength": 500 },
        "learn": { "type": "array" },
        "image": { "type": "string", "maxLength": 350000 },
        "isPopular": { "type": "boolean" },
        "popularText": { "type": "string", "maxLength": 120 },
        "order": { "type": "number" },
        "language": { "type": "string", "maxLength": 80 },
        "videos": { "type": "array" },
        "pdfs": { "type": "array" },
        "includeLive": { "type": "boolean" },
        "includeCertificate": { "type": "boolean" },
        "hasLiveSessions": { "type": "boolean" },
        "certificateTitle": { "type": "string", "maxLength": 120 },
        "certificateSubtitle": { "type": "string", "maxLength": 160 },
        "certificateInstituteName": { "type": "string", "maxLength": 160 },
        "certificateCourseTitle": { "type": "string", "maxLength": 200 },
        "certificateDescription": { "type": "string", "maxLength": 1500 },
        "certificateTheme": { "type": "string", "maxLength": 40 },
        "certificateLogoUrl": { "type": "string", "maxLength": 350000 },
        "certificateDirectorName": { "type": "string", "maxLength": 120 },
        "certificateDirectorTitle": { "type": "string", "maxLength": 120 },
        "certificateDirectorSignatureUrl": { "type": "string", "maxLength": 350000 },
        "certificateCeoName": { "type": "string", "maxLength": 120 },
        "certificateCeoTitle": { "type": "string", "maxLength": 120 },
        "certificateCeoSignatureUrl": { "type": "string", "maxLength": 350000 },
        "certificateStampUrl": { "type": "string", "maxLength": 350000 },
        "certificateSealText": { "type": "string", "maxLength": 160 },
        "paymentConfig": { "type": "object" },
        "lastEditedBySubAdminCode": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "price", "amount", "message", "learn", "image", "videos"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "LMS per-student video and PDF completion progress map",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courses": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "courses", "updatedAt"]
    },
    "LiveSession": {
      "title": "LiveSession",
      "description": "Public student-facing metadata for a course live Zoom class (never stores Zoom URL)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\- ]+$" },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "scheduledDate": { "type": "string", "maxLength": 40 },
        "scheduledTime": { "type": "string", "maxLength": 40 },
        "durationMinutes": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["live", "scheduled", "ended"] },
        "hostName": { "type": "string", "maxLength": 120 },
        "createdByRole": { "type": "string", "enum": ["main_admin", "sub_admin"] },
        "createdBySubAdminCode": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "courseId", "courseTitle", "title", "status", "hostName", "createdByRole", "createdAt", "updatedAt"]
    },
    "LiveSessionSecret": {
      "title": "LiveSessionSecret",
      "description": "Encrypted AES-256-GCM Zoom URL payload resolved strictly on server API routes",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\- ]+$" },
        "encryptedZoomLink": { "type": "string", "maxLength": 4000 },
        "zoomLink": { "type": "string", "maxLength": 4000 },
        "updatedAt": { "type": "number" }
      },
      "required": ["sessionId", "courseId", "updatedAt"]
    },
    "PushNotification": {
      "title": "PushNotification",
      "description": "Broadcast or course-targeted live class notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 250 },
        "body": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["discount", "welcome", "announcement", "course", "live", "live_class", "live_reminder", "general"] },
        "badge": { "type": "string", "maxLength": 60 },
        "url": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" },
        "author": { "type": "string", "maxLength": 120 },
        "createdBySubAdminCode": { "type": "string", "maxLength": 64 },
        "target": { "type": "string", "enum": ["all", "students", "course_students", "course_enrolled"] },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "liveClassId": { "type": "string", "maxLength": 128 },
        "deliveryKey": { "type": "string", "maxLength": 160 },
        "reminderType": { "type": "string", "maxLength": 40 },
        "icon": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "title", "body", "type", "createdAt"]
    },
    "SystemDocument": {
      "title": "SystemDocument",
      "description": "Global platform configuration documents (payment_qr, faqs, site_settings, config, admin_session)",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "number" }
      }
    },
    "SupportConversation": {
      "title": "SupportConversation",
      "description": "Role-isolated support conversation (Student <-> Sub-Admin or Sub-Admin <-> Main Admin)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160 },
        "userId": { "type": "string", "maxLength": 160 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userPhone": { "type": "string", "maxLength": 40 },
        "userAvatar": { "type": "string", "maxLength": 350000 },
        "purchasedCourses": { "type": "array" },
        "channelType": { "type": "string", "enum": ["student_mainadmin", "student_subadmin", "subadmin_mainadmin"] },
        "subAdminCode": { "type": "string", "maxLength": 64 },
        "subAdminProfileId": { "type": "string", "maxLength": 128 },
        "subAdminUid": { "type": "string", "maxLength": 128 },
        "subAdminName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "activeCourse": { "type": "string", "maxLength": 200 },
        "lastMessage": { "type": "string", "maxLength": 2000 },
        "lastMessageAt": { "type": "number" },
        "lastSender": { "type": "string", "enum": ["user", "admin", "system"] },
        "unreadAdminCount": { "type": "number" },
        "unreadUserCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "clearedByUserAt": { "type": "number" },
        "clearedByAdminAt": { "type": "number" }
      },
      "required": ["userId", "userName"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Single message inside a role-isolated support conversation",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "maxLength": 160 },
        "sender": { "type": "string", "enum": ["user", "admin"] },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderAvatar": { "type": "string", "maxLength": 350000 },
        "text": { "type": "string", "maxLength": 5000 },
        "timestamp": { "type": "number" },
        "isSeen": { "type": "boolean" },
        "seenAt": { "type": "number" },
        "status": { "type": "string", "enum": ["sent", "seen"] },
        "attachmentType": { "type": "string", "enum": ["image", "document"] },
        "attachmentUrl": { "type": "string", "maxLength": 900000 },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "attachmentSize": { "type": "number" }
      },
      "required": ["conversationId", "sender", "senderName", "text", "timestamp"]
    },
    "LiveClass": {
      "title": "LiveClass",
      "description": "Server-managed live class record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["draft", "published", "live", "completed", "cancelled"] },
        "scheduledStartAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "courseId", "title", "status"]
    },
    "LiveClassRegistration": {
      "title": "LiveClassRegistration",
      "description": "Student seat registration under a live class",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "liveClassId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "registeredAt": { "type": "number" }
      },
      "required": ["liveClassId", "userId"]
    },
    "LiveClassSecret": {
      "title": "LiveClassSecret",
      "description": "Server-only live class credentials and meeting secrets",
      "type": "object",
      "properties": {
        "liveClassId": { "type": "string", "maxLength": 128 },
        "provider": { "type": "string", "maxLength": 40 }
      },
      "required": ["liveClassId"]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "Registered FCM Web Push device token scoped by enrolledCourseIds",
      "type": "object",
      "properties": {
        "token": { "type": "string", "maxLength": 4096 },
        "userId": { "type": "string", "maxLength": 128 },
        "enrolledCourseIds": { "type": "array" },
        "activationCode": { "type": "string", "maxLength": 64 },
        "platform": { "type": "string", "maxLength": 40 },
        "isPwa": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["token", "userId", "enrolledCourseIds", "updatedAt"]
    },
    "NotificationDelivery": {
      "title": "NotificationDelivery",
      "description": "Server deduplication lock for scheduled live class reminders",
      "type": "object",
      "properties": {
        "deliveryKey": { "type": "string", "maxLength": 160 },
        "liveClassId": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "reminderType": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "number" }
      },
      "required": ["deliveryKey", "liveClassId", "createdAt"]
    },
    "HealthProbe": {
      "title": "HealthProbe",
      "description": "Connectivity verification probe document",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "admins/{adminUid}": {
      "schema": "AdminUser",
      "description": "Trusted Main Admin UID grants"
    },
    "test/{docId}": {
      "schema": "HealthProbe",
      "description": "Startup Firestore server connectivity check document"
    },
    "course_requests/{requestId}": {
      "schema": "CourseRequest",
      "description": "Student payment and activation course requests"
    },
    "activation_keys/{code}": {
      "schema": "ActivationKey",
      "description": "Single-device subscription activation keys"
    },
    "user_progress/{userId}": {
      "schema": "UserProgress",
      "description": "LMS per-student video and PDF completion progress"
    },
    "courses/{courseId}": {
      "schema": "Course",
      "description": "Dynamic courses available for enrollment"
    },
    "live_sessions/{sessionId}": {
      "schema": "LiveSession",
      "description": "Public live class session metadata without exposing Zoom links"
    },
    "live_session_secrets/{sessionId}": {
      "schema": "LiveSessionSecret",
      "description": "AES-256-GCM encrypted Zoom meeting URLs resolved on the backend"
    },
    "notifications/{notificationId}": {
      "schema": "PushNotification",
      "description": "Broadcast and course-targeted live class notifications"
    },
    "system/{configId}": {
      "schema": "SystemDocument",
      "description": "Global platform configuration docs (payment_qr, faqs, site_settings, config, admin_session)"
    },
    "support_conversations/{conversationId}": {
      "schema": "SupportConversation",
      "description": "Role-isolated support threads"
    },
    "support_conversations/{conversationId}/messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Messages inside support threads"
    },
    "sub_admins/{code}": {
      "schema": "SubAdminAccount",
      "description": "Protected course-scoped sub-admin credentials (never listable by students)"
    },
    "sub_admin_profiles/{profileId}": {
      "schema": "SubAdminPublicProfile",
      "description": "Non-secret public instructor routing profiles (no secret codes)"
    },
    "liveClasses/{liveClassId}": {
      "schema": "LiveClass",
      "description": "Server-managed live classes"
    },
    "liveClasses/{liveClassId}/registrations/{regId}": {
      "schema": "LiveClassRegistration",
      "description": "Live class student registrations"
    },
    "liveClassSecrets/{liveClassId}": {
      "schema": "LiveClassSecret",
      "description": "Server-only live class credentials"
    },
    "fcmTokens/{tokenId}": {
      "schema": "FcmToken",
      "description": "Scoped student push notification device tokens"
    },
    "notificationDeliveries/{deliveryId}": {
      "schema": "NotificationDelivery",
      "description": "Server reminder deduplication records"
    }
  }
}

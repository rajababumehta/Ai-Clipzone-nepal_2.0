rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PILLAR 1 & PHASE 4: Global Default-Deny Catch-All Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // GLOBAL SECURITY HELPERS & TYPE / BOUNDARY PRIMITIVES
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCourseId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\- ]+$');
    }

    function isValidConversationId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-@. ]+$');
    }

    function optStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function optNum(data, field) {
      return !(field in data) || (data[field] is number || data[field] is timestamp);
    }

    function optBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    // Strict verified-email Admin token check (safe inside allow list: no get/exists)
    function isAdminToken() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        (
          request.auth.token.email.lower() == 'ai.clipzone.edu@gmail.com' ||
          request.auth.token.email.lower() == 'rajababum426@gmail.com'
        );
    }

    // Full Admin check (only for single-doc get / create / update / delete, NOT list)
    function isAdmin() {
      return isAdminToken() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Verify Sub-Admin active status, course scope, and bound Firebase UID
    function isActiveSubAdminOwner(subCode, targetCourseId) {
      return isSignedIn() &&
        subCode is string &&
        isValidId(subCode) &&
        exists(/databases/$(database)/documents/sub_admins/$(subCode)) &&
        get(/databases/$(database)/documents/sub_admins/$(subCode)).data.status == 'active' &&
        get(/databases/$(database)/documents/sub_admins/$(subCode)).data.courseId == targetCourseId &&
        get(/databases/$(database)/documents/sub_admins/$(subCode)).data.activeUid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // ENTITY VALIDATION BLUEPRINTS (PILLAR 2: ANTI-UPDATE-GAP)
    // -------------------------------------------------------------------------
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.role == 'main_admin' &&
        optStr(data, 'email', 200) &&
        optNum(data, 'createdAt');
    }

    function isValidCourseRequest(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'courseId', 'courseTitle', 'status', 'requestedAt']) &&
        data.keys().hasOnly(['userId', 'userEmail', 'courseId', 'courseTitle', 'status', 'requestedAt', 'expiresAt', 'duration']) &&
        isValidId(data.userId) &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200 &&
        isValidCourseId(data.courseId) &&
        data.courseTitle is string && data.courseTitle.size() >= 1 && data.courseTitle.size() <= 200 &&
        data.status in ['pending', 'accepted', 'declined'] &&
        data.requestedAt is number &&
        optNum(data, 'expiresAt') &&
        (!( 'duration' in data ) || data.duration in ['1month', '1year']);
    }

    function isValidActivationKey(data) {
      return data.keys().hasAll(['code', 'status', 'duration', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'code', 'status', 'duration', 'createdAt',
          'courseId', 'courseTitle', 'studentName', 'claimedByName',
          'claimedByEmail', 'claimedByUid', 'originalOwnerUid',
          'claimedAt', 'expiresAt', 'activeDeviceId', 'deviceClaimedAt',
          'forceLogoutAt', 'studentAvatar', 'studentAvatarUpdatedAt',
          'createdByRole', 'createdBySubAdminCode', 'createdByName',
          'subAdminUid', 'isExpired'
        ]) &&
        data.code is string && isValidId(data.code) && data.code.size() <= 64 &&
        data.status in ['unused', 'used', 'expired', 'deleted'] &&
        data.duration in ['1day', '1month', '1year'] &&
        data.createdAt is number &&
        optStr(data, 'id', 128) &&
        optStr(data, 'courseId', 128) &&
        optStr(data, 'courseTitle', 200) &&
        optStr(data, 'studentName', 120) &&
        optStr(data, 'claimedByName', 120) &&
        optStr(data, 'claimedByEmail', 200) &&
        optStr(data, 'claimedByUid', 128) &&
        optStr(data, 'originalOwnerUid', 128) &&
        optNum(data, 'claimedAt') &&
        optNum(data, 'expiresAt') &&
        optStr(data, 'activeDeviceId', 128) &&
        optNum(data, 'deviceClaimedAt') &&
        optNum(data, 'forceLogoutAt') &&
        optStr(data, 'studentAvatar', 350000) &&
        optNum(data, 'studentAvatarUpdatedAt') &&
        (!('createdByRole' in data) || data.createdByRole in ['main_admin', 'sub_admin']) &&
        optStr(data, 'createdBySubAdminCode', 64) &&
        optStr(data, 'createdByName', 120) &&
        optStr(data, 'subAdminUid', 128) &&
        optBool(data, 'isExpired');
    }

    function isValidSubAdmin(data) {
      return data.keys().hasAll(['code', 'name', 'courseId', 'courseTitle', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'code', 'publicProfileId', 'name', 'courseId', 'courseTitle',
          'avatarUrl', 'status', 'activeUid', 'createdAt', 'updatedAt',
          'lastLoginAt', 'activeDeviceId'
        ]) &&
        data.code is string && isValidId(data.code) && data.code.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidCourseId(data.courseId) &&
        data.courseTitle is string && data.courseTitle.size() >= 1 && data.courseTitle.size() <= 200 &&
        data.status in ['active', 'disabled'] &&
        data.createdAt is number &&
        optStr(data, 'id', 128) &&
        optStr(data, 'publicProfileId', 128) &&
        optStr(data, 'avatarUrl', 350000) &&
        optStr(data, 'activeUid', 128) &&
        optNum(data, 'updatedAt') &&
        optNum(data, 'lastLoginAt') &&
        optStr(data, 'activeDeviceId', 128);
    }

    function isValidSubAdminProfile(data) {
      return data.keys().hasAll(['id', 'courseId', 'courseTitle', 'name', 'status']) &&
        data.keys().hasOnly(['id', 'courseId', 'courseTitle', 'name', 'avatarUrl', 'status', 'activeUid', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidCourseId(data.courseId) &&
        data.courseTitle is string && data.courseTitle.size() >= 1 && data.courseTitle.size() <= 200 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.status in ['active', 'disabled'] &&
        optStr(data, 'avatarUrl', 350000) &&
        optStr(data, 'activeUid', 128) &&
        optNum(data, 'updatedAt');
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['id', 'title', 'price', 'amount', 'message', 'learn', 'image', 'videos']) &&
        data.keys().hasOnly([
          'id', 'title', 'price', 'amount', 'message', 'learn', 'image',
          'isPopular', 'popularText', 'order', 'language', 'videos', 'pdfs',
          'includeLive', 'includeCertificate', 'hasLiveSessions',
          'certificateTitle', 'certificateSubtitle', 'certificateInstituteName',
          'certificateCourseTitle', 'certificateDescription', 'certificateTheme',
          'certificateLogoUrl', 'certificateDirectorName', 'certificateDirectorTitle',
          'certificateDirectorSignatureUrl', 'certificateCeoName', 'certificateCeoTitle',
          'certificateCeoSignatureUrl', 'certificateStampUrl', 'certificateSealText',
          'paymentConfig', 'lastEditedBySubAdminCode'
        ]) &&
        isValidCourseId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.price is string && data.price.size() <= 64 &&
        data.amount is number && data.amount >= 0 &&
        data.message is string && data.message.size() <= 500 &&
        data.learn is list && data.learn.size() <= 100 && (data.learn.size() == 0 || data.learn[0] is string) &&
        data.image is string && data.image.size() <= 350000 &&
        data.videos is list && data.videos.size() <= 300 && (data.videos.size() == 0 || (data.videos[0] is map && data.videos[0].title is string && data.videos[0].videoUrl is string)) &&
        (!('pdfs' in data) || (data.pdfs is list && data.pdfs.size() <= 200 && (data.pdfs.size() == 0 || (data.pdfs[0] is map && data.pdfs[0].title is string && data.pdfs[0].pdfUrl is string)))) &&
        optBool(data, 'isPopular') &&
        optStr(data, 'popularText', 120) &&
        optNum(data, 'order') &&
        optStr(data, 'language', 80) &&
        optBool(data, 'includeLive') &&
        optBool(data, 'includeCertificate') &&
        optBool(data, 'hasLiveSessions') &&
        optStr(data, 'certificateTitle', 120) &&
        optStr(data, 'certificateSubtitle', 160) &&
        optStr(data, 'certificateInstituteName', 160) &&
        optStr(data, 'certificateCourseTitle', 200) &&
        optStr(data, 'certificateDescription', 1500) &&
        optStr(data, 'certificateTheme', 40) &&
        optStr(data, 'certificateLogoUrl', 350000) &&
        optStr(data, 'certificateDirectorName', 120) &&
        optStr(data, 'certificateDirectorTitle', 120) &&
        optStr(data, 'certificateDirectorSignatureUrl', 350000) &&
        optStr(data, 'certificateCeoName', 120) &&
        optStr(data, 'certificateCeoTitle', 120) &&
        optStr(data, 'certificateCeoSignatureUrl', 350000) &&
        optStr(data, 'certificateStampUrl', 350000) &&
        optStr(data, 'certificateSealText', 160) &&
        (!('paymentConfig' in data) || data.paymentConfig is map) &&
        optStr(data, 'lastEditedBySubAdminCode', 64);
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['userId', 'courses', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'courses', 'updatedAt']) &&
        isValidId(data.userId) &&
        data.courses is map &&
        data.courses.keys().size() <= 200 &&
        data.updatedAt is number;
    }

    function isValidLiveSession(data) {
      return data.keys().hasAll(['id', 'courseId', 'courseTitle', 'title', 'status', 'hostName', 'createdByRole', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'courseId', 'courseTitle', 'title', 'description',
          'scheduledDate', 'scheduledTime', 'durationMinutes', 'status',
          'hostName', 'createdByRole', 'createdBySubAdminCode', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidCourseId(data.courseId) &&
        data.courseTitle is string && data.courseTitle.size() >= 1 && data.courseTitle.size() <= 200 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.status in ['live', 'scheduled', 'ended'] &&
        data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 120 &&
        data.createdByRole in ['main_admin', 'sub_admin'] &&
        data.createdAt is number &&
        data.updatedAt is number &&
        optStr(data, 'description', 2000) &&
        optStr(data, 'scheduledDate', 40) &&
        optStr(data, 'scheduledTime', 40) &&
        optStr(data, 'durationMinutes', 20) &&
        optStr(data, 'createdBySubAdminCode', 64);
    }

    function isValidLiveSessionSecret(data) {
      return data.keys().hasAll(['sessionId', 'courseId', 'updatedAt']) &&
        data.keys().hasOnly(['sessionId', 'courseId', 'encryptedZoomLink', 'zoomLink', 'updatedAt']) &&
        isValidId(data.sessionId) &&
        isValidCourseId(data.courseId) &&
        data.updatedAt is number &&
        optStr(data, 'encryptedZoomLink', 4000) &&
        optStr(data, 'zoomLink', 4000);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'body', 'type', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'title', 'body', 'type', 'badge', 'url', 'createdAt',
          'author', 'createdBySubAdminCode', 'target', 'courseId',
          'courseTitle', 'sessionId', 'liveClassId', 'deliveryKey',
          'reminderType', 'icon'
        ]) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 250 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
        data.type in ['discount', 'welcome', 'announcement', 'course', 'live', 'live_class', 'live_reminder', 'general'] &&
        data.createdAt is number &&
        optStr(data, 'badge', 60) &&
        optStr(data, 'url', 500) &&
        optStr(data, 'author', 120) &&
        optStr(data, 'createdBySubAdminCode', 64) &&
        (!('target' in data) || data.target in ['all', 'students', 'course_students', 'course_enrolled']) &&
        optStr(data, 'courseId', 128) &&
        optStr(data, 'courseTitle', 200) &&
        optStr(data, 'sessionId', 128) &&
        optStr(data, 'liveClassId', 128) &&
        optStr(data, 'deliveryKey', 160) &&
        optStr(data, 'reminderType', 40) &&
        optStr(data, 'icon', 500);
    }

    function isValidSupportConversation(data) {
      return data.keys().hasAll(['userId', 'userName']) &&
        data.keys().hasOnly([
          'id', 'userId', 'ownerUid', 'userName', 'userEmail', 'userPhone',
          'userAvatar', 'purchasedCourses', 'channelType', 'subAdminCode',
          'subAdminProfileId', 'subAdminUid', 'subAdminName', 'courseId',
          'activeCourse', 'lastMessage', 'lastMessageAt', 'lastSender',
          'unreadAdminCount', 'unreadUserCount', 'createdAt', 'updatedAt',
          'clearedByUserAt', 'clearedByAdminAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 160 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        optStr(data, 'id', 160) &&
        optStr(data, 'ownerUid', 128) &&
        optStr(data, 'userEmail', 200) &&
        optStr(data, 'userPhone', 40) &&
        optStr(data, 'userAvatar', 350000) &&
        (!('purchasedCourses' in data) || (data.purchasedCourses is list && data.purchasedCourses.size() <= 50 && (data.purchasedCourses.size() == 0 || data.purchasedCourses[0] is string))) &&
        (!('channelType' in data) || data.channelType in ['student_mainadmin', 'student_subadmin', 'subadmin_mainadmin']) &&
        optStr(data, 'subAdminCode', 64) &&
        optStr(data, 'subAdminProfileId', 128) &&
        optStr(data, 'subAdminUid', 128) &&
        optStr(data, 'subAdminName', 120) &&
        optStr(data, 'courseId', 128) &&
        optStr(data, 'activeCourse', 200) &&
        optStr(data, 'lastMessage', 2000) &&
        optNum(data, 'lastMessageAt') &&
        (!('lastSender' in data) || data.lastSender in ['user', 'admin', 'system']) &&
        optNum(data, 'unreadAdminCount') &&
        optNum(data, 'unreadUserCount') &&
        optNum(data, 'createdAt') &&
        optNum(data, 'updatedAt') &&
        optNum(data, 'clearedByUserAt') &&
        optNum(data, 'clearedByAdminAt');
    }

    function isValidSupportMessage(data) {
      return data.keys().hasAll(['conversationId', 'sender', 'senderName', 'text', 'timestamp']) &&
        data.keys().hasOnly([
          'conversationId', 'sender', 'senderName', 'senderAvatar', 'text',
          'timestamp', 'isSeen', 'seenAt', 'status', 'attachmentType',
          'attachmentUrl', 'attachmentName', 'attachmentSize'
        ]) &&
        isValidConversationId(data.conversationId) &&
        data.sender in ['user', 'admin'] &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.text is string && data.text.size() <= 5000 &&
        data.timestamp is number &&
        optStr(data, 'senderAvatar', 350000) &&
        optBool(data, 'isSeen') &&
        optNum(data, 'seenAt') &&
        (!('status' in data) || data.status in ['sent', 'seen']) &&
        (!('attachmentType' in data) || data.attachmentType in ['image', 'document']) &&
        optStr(data, 'attachmentUrl', 900000) &&
        optStr(data, 'attachmentName', 200) &&
        optNum(data, 'attachmentSize');
    }

    function isValidFcmToken(data) {
      return data.keys().hasAll(['token', 'userId', 'enrolledCourseIds', 'updatedAt']) &&
        data.keys().hasOnly(['token', 'userId', 'enrolledCourseIds', 'activationCode', 'platform', 'isPwa', 'updatedAt']) &&
        data.token is string && data.token.size() >= 20 && data.token.size() <= 4096 &&
        isValidId(data.userId) &&
        data.enrolledCourseIds is list && data.enrolledCourseIds.size() <= 100 &&
        (data.enrolledCourseIds.size() == 0 || data.enrolledCourseIds[0] is string) &&
        data.updatedAt is number &&
        optStr(data, 'activationCode', 64) &&
        optStr(data, 'platform', 40) &&
        optBool(data, 'isPwa');
    }

    function isValidSystemDoc(configId, data) {
      return (
        (configId == 'payment_qr' && optStr(data, 'esewaId', 80) && optStr(data, 'accountName', 120) && optStr(data, 'whatsappNumber', 40) && optStr(data, 'qrImageUrl', 350000)) ||
        (configId == 'faqs' && data.items is list && data.items.size() <= 100) ||
        (configId == 'site_settings' && optStr(data, 'siteTitle', 200) && optStr(data, 'instituteName', 160) && optStr(data, 'instituteLogoUrl', 350000)) ||
        (configId == 'config' && (!('deletedCourseIds' in data) || (data.deletedCourseIds is list && data.deletedCourseIds.size() <= 500))) ||
        (configId == 'admin_session' && optStr(data, 'activeSessionId', 128) && optStr(data, 'deviceId', 128))
      );
    }

    function isValidLiveClass(data) {
      return data.keys().hasAll(['id', 'courseId', 'title', 'status']) &&
        isValidId(data.id) &&
        isValidCourseId(data.courseId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.status in ['draft', 'published', 'live', 'completed', 'cancelled'];
    }

    function isValidLiveClassRegistration(data) {
      return data.keys().hasAll(['liveClassId', 'userId']) &&
        isValidId(data.liveClassId) &&
        isValidId(data.userId) &&
        optStr(data, 'studentName', 120);
    }

    function isValidLiveClassSecret(data) {
      return data.keys().hasAll(['liveClassId']) &&
        isValidId(data.liveClassId) &&
        optStr(data, 'provider', 40);
    }

    function isValidNotificationDelivery(data) {
      return data.keys().hasAll(['deliveryKey', 'liveClassId', 'createdAt']) &&
        data.deliveryKey is string && data.deliveryKey.size() <= 160 &&
        isValidId(data.liveClassId) &&
        data.createdAt is number;
    }

    function isConversationParticipant(convData) {
      return convData.ownerUid == request.auth.uid ||
        convData.userId == request.auth.uid ||
        convData.subAdminUid == request.auth.uid ||
        (convData.channelType == 'subadmin_mainadmin' && isActiveSubAdminOwner(convData.subAdminCode, convData.courseId)) ||
        (convData.channelType == 'student_subadmin' && isActiveSubAdminOwner(convData.subAdminCode, convData.courseId));
    }

    // -------------------------------------------------------------------------
    // COLLECTION MATCH RULES
    // -------------------------------------------------------------------------

    // 1. Trusted Admins grant collection
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (adminUid == request.auth.uid || isAdminToken());
      allow list: if isAdminToken();
      allow create, update: if isAdminToken() && isValidId(adminUid) && isValidAdminUser(incoming()) && incoming().uid == adminUid;
      allow delete: if isAdminToken() && isValidId(adminUid);
    }

    // 2. Startup Connectivity Probe (/test/connection)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }

    // 3. Student Course Access Requests
    match /course_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdminToken() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        isValidCourseRequest(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        exists(/databases/$(database)/documents/courses/$(incoming().courseId));
      allow update: if isSignedIn() &&
        isValidId(requestId) &&
        isValidCourseRequest(incoming()) && (
          isAdmin() ||
          (
            existing().status == 'pending' &&
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().courseId == existing().courseId &&
            incoming().status == existing().status &&
            incoming().requestedAt == existing().requestedAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['userEmail', 'courseTitle'])
          )
        );
      allow delete: if isAdmin() && isValidId(requestId);
    }

    // 4. Single-Device Activation Keys
    match /activation_keys/{keyCode} {
      // Exact key bearer lookup (student must know the secret CLIP-* code) or Admin/Sub-Admin owner
      allow get: if isSignedIn() && isValidId(keyCode);
      // Scoped list queries only (zero get/exists inside list)
      allow list: if isSignedIn() && (
        isAdminToken() ||
        resource.data.claimedByUid == request.auth.uid ||
        resource.data.subAdminUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        isValidId(keyCode) &&
        isValidActivationKey(incoming()) &&
        incoming().code == keyCode && (
          isAdmin() ||
          (
            incoming().createdByRole == 'sub_admin' &&
            incoming().subAdminUid == request.auth.uid &&
            isActiveSubAdminOwner(incoming().createdBySubAdminCode, incoming().courseId)
          )
        );
      allow update: if isSignedIn() &&
        isValidId(keyCode) &&
        isValidActivationKey(incoming()) &&
        incoming().code == existing().code &&
        incoming().duration == existing().duration &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          // Course Sub-Admin managing their own issued keys
          (
            existing().createdByRole == 'sub_admin' &&
            existing().subAdminUid == request.auth.uid &&
            isActiveSubAdminOwner(existing().createdBySubAdminCode, existing().courseId) &&
            incoming().courseId == existing().courseId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'activeDeviceId', 'forceLogoutAt', 'status', 'expiresAt', 'subAdminUid'])
          ) ||
          // Student First Claim of unused key
          (
            existing().status == 'unused' &&
            incoming().status == 'used' &&
            incoming().claimedByUid == request.auth.uid &&
            incoming().originalOwnerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'activeDeviceId', 'deviceClaimedAt', 'forceLogoutAt',
              'originalOwnerUid', 'claimedByUid', 'studentName', 'claimedByEmail',
              'claimedAt', 'expiresAt', 'studentAvatar', 'studentAvatarUpdatedAt'
            ])
          ) ||
          // Student Re-claim / Secondary login when key is released, or Owner Avatar / Device Sync / Logout Release
          (
            existing().status == 'used' &&
            incoming().status in ['used', 'expired'] &&
            (
              existing().claimedByUid == request.auth.uid ||
              existing().originalOwnerUid == request.auth.uid ||
              !('activeDeviceId' in existing()) ||
              existing().activeDeviceId == ''
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'activeDeviceId', 'deviceClaimedAt', 'forceLogoutAt',
              'claimedByUid', 'studentName', 'studentAvatar', 'studentAvatarUpdatedAt'
            ])
          ) ||
          // Automatic key expiry lock
          (
            existing().status == 'used' &&
            incoming().status == 'expired' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          )
        );
      allow delete: if isSignedIn() && isValidId(keyCode) && (
        isAdmin() ||
        (
          existing().createdByRole == 'sub_admin' &&
          existing().subAdminUid == request.auth.uid &&
          isActiveSubAdminOwner(existing().createdBySubAdminCode, existing().courseId)
        )
      );
    }

    // 5. LMS Per-Student Video & PDF Progress (Strict Owner Isolation)
    match /user_progress/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
      allow list: if isAdminToken();
      allow create, update: if isSignedIn() &&
        isValidId(userId) &&
        (userId == request.auth.uid || isAdmin()) &&
        isValidUserProgress(incoming()) &&
        incoming().userId == userId;
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 6. Course-Scoped Sub-Admin Secret Accounts (NEVER listable by students)
    match /sub_admins/{subCode} {
      allow get: if isSignedIn() && isValidId(subCode);
      allow list: if isAdminToken();
      allow create: if isAdmin() && isValidId(subCode) && isValidSubAdmin(incoming()) && incoming().code == subCode;
      allow update: if isSignedIn() &&
        isValidId(subCode) &&
        isValidSubAdmin(incoming()) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().status == 'active' &&
            incoming().courseId == existing().courseId &&
            incoming().status == existing().status &&
            (
              // Sub-Admin session device binding on code login
              (
                (!('activeDeviceId' in existing()) || existing().activeDeviceId == '' || existing().activeDeviceId == incoming().activeDeviceId) &&
                incoming().activeUid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginAt', 'activeDeviceId', 'activeUid'])
              ) ||
              // Bound Sub-Admin releasing device or updating own avatar
              (
                existing().activeUid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['activeDeviceId', 'avatarUrl', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(subCode);
    }

    // 7. Non-Secret Public Instructor Routing Directory (never contains login code)
    match /sub_admin_profiles/{profileId} {
      allow get: if isValidId(profileId) && resource.data.status in ['active', 'disabled'];
      allow list: if resource.data.status == 'active' && resource.data.courseId is string;
      allow create, update: if isSignedIn() &&
        isValidId(profileId) &&
        isValidSubAdminProfile(incoming()) &&
        incoming().id == profileId && (
          isAdmin() ||
          (
            resource != null &&
            existing().status == 'active' &&
            incoming().courseId == existing().courseId &&
            incoming().status == existing().status &&
            (
              (incoming().activeUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['activeUid', 'updatedAt'])) ||
              (existing().activeUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['avatarUrl', 'updatedAt']))
            )
          )
        );
      allow delete: if isAdmin() && isValidId(profileId);
    }

    // 8. Courses Catalog
    match /courses/{courseId} {
      allow get: if isValidCourseId(courseId) && resource.data.id is string;
      allow list: if resource.data.id is string && resource.data.title is string;
      allow create: if isAdmin() && isValidCourseId(courseId) && isValidCourse(incoming()) && incoming().id == courseId;
      allow update: if isSignedIn() &&
        isValidCourseId(courseId) &&
        isValidCourse(incoming()) &&
        incoming().id == existing().id && (
          isAdmin() ||
          (
            isActiveSubAdminOwner(incoming().lastEditedBySubAdminCode, courseId) &&
            // Sub-Admins NEVER modify live/certificate flags
            ((!('includeLive' in existing()) && !('includeLive' in incoming())) || ('includeLive' in existing() && 'includeLive' in incoming() && incoming().includeLive == existing().includeLive)) &&
            ((!('includeCertificate' in existing()) && !('includeCertificate' in incoming())) || ('includeCertificate' in existing() && 'includeCertificate' in incoming() && incoming().includeCertificate == existing().includeCertificate)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'price', 'amount', 'message', 'learn', 'image',
              'isPopular', 'popularText', 'language', 'videos', 'pdfs',
              'certificateTitle', 'certificateSubtitle', 'certificateInstituteName',
              'certificateCourseTitle', 'certificateDescription', 'certificateTheme',
              'certificateLogoUrl', 'certificateDirectorName', 'certificateDirectorTitle',
              'certificateDirectorSignatureUrl', 'certificateCeoName', 'certificateCeoTitle',
              'certificateCeoSignatureUrl', 'certificateStampUrl', 'certificateSealText',
              'paymentConfig', 'lastEditedBySubAdminCode'
            ])
          )
        );
      allow delete: if isAdmin() && isValidCourseId(courseId);
    }

    // 9. Public Live Session Metadata (Zero Zoom links stored here)
    match /live_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && resource.data.courseId is string;
      allow list: if resource.data.courseId is string && resource.data.status in ['live', 'scheduled', 'ended'];
      allow create: if isSignedIn() &&
        isValidId(sessionId) &&
        isValidLiveSession(incoming()) &&
        incoming().id == sessionId &&
        exists(/databases/$(database)/documents/courses/$(incoming().courseId)) && (
          isAdmin() ||
          (
            incoming().createdByRole == 'sub_admin' &&
            isActiveSubAdminOwner(incoming().createdBySubAdminCode, incoming().courseId) &&
            get(/databases/$(database)/documents/courses/$(incoming().courseId)).data.includeLive == true
          )
        );
      allow update: if isSignedIn() &&
        isValidId(sessionId) &&
        isValidLiveSession(incoming()) &&
        incoming().id == existing().id &&
        incoming().courseId == existing().courseId &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdByRole == existing().createdByRole && (
          isAdmin() ||
          (
            existing().createdByRole == 'sub_admin' &&
            isActiveSubAdminOwner(existing().createdBySubAdminCode, existing().courseId)
          )
        );
      allow delete: if isSignedIn() && isValidId(sessionId) && (
        isAdmin() ||
        (
          existing().createdByRole == 'sub_admin' &&
          isActiveSubAdminOwner(existing().createdBySubAdminCode, existing().courseId)
        )
      );
    }

    // 10. Protected Encrypted Zoom Secrets (Disallow Listing completely)
    match /live_session_secrets/{sessionId} {
      // Encrypted AES-256-GCM ciphertext readable only via authenticated REST token on server join verification
      allow get: if isSignedIn() && isValidId(sessionId);
      allow list: if false;
      allow create, update: if isSignedIn() &&
        isValidId(sessionId) &&
        isValidLiveSessionSecret(incoming()) &&
        incoming().sessionId == sessionId &&
        exists(/databases/$(database)/documents/live_sessions/$(sessionId)) && (
          isAdmin() ||
          (
            get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.createdByRole == 'sub_admin' &&
            isActiveSubAdminOwner(
              get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.createdBySubAdminCode,
              incoming().courseId
            )
          )
        );
      allow delete: if isSignedIn() && isValidId(sessionId) && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/live_sessions/$(sessionId)) &&
          get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.createdByRole == 'sub_admin' &&
          isActiveSubAdminOwner(
            get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.createdBySubAdminCode,
            existing().courseId
          )
        )
      );
    }

    // 11. Broadcast & Live Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && resource.data.title is string;
      allow list: if resource.data.title is string && resource.data.createdAt is number;
      allow create: if isSignedIn() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().id == notificationId && (
          isAdmin() ||
          (
            incoming().target == 'course_students' &&
            incoming().type == 'live' &&
            isActiveSubAdminOwner(incoming().createdBySubAdminCode, incoming().courseId)
          )
        );
      allow update, delete: if isAdmin() && isValidId(notificationId);
    }

    // 12. System Settings & Admin Session Configuration
    match /system/{configId} {
      allow get: if (configId in ['payment_qr', 'faqs', 'site_settings', 'config'] && resource.data.keys().size() >= 0) ||
        (configId == 'admin_session' && isAdmin());
      allow list: if false;
      allow create, update: if isAdmin() &&
        configId in ['payment_qr', 'faqs', 'site_settings', 'config', 'admin_session'] &&
        isValidSystemDoc(configId, incoming());
      allow delete: if isAdmin() && configId in ['payment_qr', 'faqs', 'site_settings', 'config', 'admin_session'];
    }

    // 13. Support Conversations & Messages (Master Gate + Scoped List Queries)
    match /support_conversations/{conversationId} {
      allow get: if isSignedIn() && isValidConversationId(conversationId) && (
        isAdmin() ||
        isConversationParticipant(existing())
      );
      allow list: if isSignedIn() && (
        isAdminToken() ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.subAdminUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        isValidConversationId(conversationId) &&
        isValidSupportConversation(incoming()) && (
          isAdmin() ||
          incoming().ownerUid == request.auth.uid ||
          incoming().userId == request.auth.uid ||
          (incoming().channelType == 'subadmin_mainadmin' && isActiveSubAdminOwner(incoming().subAdminCode, incoming().courseId)) ||
          (incoming().channelType == 'student_subadmin' && incoming().subAdminUid == request.auth.uid)
        );
      allow update: if isSignedIn() &&
        isValidConversationId(conversationId) &&
        isValidSupportConversation(incoming()) &&
        incoming().userId == existing().userId && (
          isAdmin() ||
          isConversationParticipant(existing())
        );
      allow delete: if isSignedIn() && isValidConversationId(conversationId) && (
        isAdmin() ||
        existing().ownerUid == request.auth.uid ||
        existing().subAdminUid == request.auth.uid ||
        (existing().channelType == 'subadmin_mainadmin' && isActiveSubAdminOwner(existing().subAdminCode, existing().courseId))
      );

      // Subcollection Master Gate referencing parent conversation
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidConversationId(conversationId) && isValidId(messageId) &&
          exists(/databases/$(database)/documents/support_conversations/$(conversationId)) && (
            isAdmin() ||
            isConversationParticipant(get(/databases/$(database)/documents/support_conversations/$(conversationId)).data)
          );
        allow list: if isSignedIn() && isValidConversationId(conversationId) && (
          isAdminToken() ||
          !exists(/databases/$(database)/documents/support_conversations/$(conversationId)) ||
          isConversationParticipant(get(/databases/$(database)/documents/support_conversations/$(conversationId)).data)
        );
        allow create: if isSignedIn() &&
          isValidConversationId(conversationId) &&
          isValidId(messageId) &&
          isValidSupportMessage(incoming()) &&
          incoming().conversationId == conversationId &&
          exists(/databases/$(database)/documents/support_conversations/$(conversationId)) && (
            isAdmin() ||
            isConversationParticipant(get(/databases/$(database)/documents/support_conversations/$(conversationId)).data)
          );
        allow update: if isSignedIn() &&
          isValidConversationId(conversationId) &&
          isValidId(messageId) &&
          isValidSupportMessage(incoming()) &&
          incoming().conversationId == existing().conversationId &&
          incoming().timestamp == existing().timestamp &&
          exists(/databases/$(database)/documents/support_conversations/$(conversationId)) &&
          (isAdmin() || isConversationParticipant(get(/databases/$(database)/documents/support_conversations/$(conversationId)).data)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isSeen', 'seenAt', 'status']);
        allow delete: if isSignedIn() && isValidConversationId(conversationId) && isValidId(messageId) && (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/support_conversations/$(conversationId)) &&
            get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.subAdminUid == request.auth.uid
          )
        );
      }
    }

    // 14. Server-Managed Live Classes & Registrations (Rest API / Admin)
    match /liveClasses/{liveClassId} {
      allow get: if isValidId(liveClassId) && (resource.data.status != 'draft' || isAdmin());
      allow list: if resource.data.status in ['published', 'live', 'completed', 'cancelled'] || isAdminToken();
      allow create, update: if isAdmin() && isValidId(liveClassId) && isValidLiveClass(incoming());
      allow delete: if isAdmin() && isValidId(liveClassId);

      match /registrations/{regId} {
        allow get: if isSignedIn() && isValidId(liveClassId) && isValidId(regId) &&
          exists(/databases/$(database)/documents/liveClasses/$(liveClassId)) &&
          (existing().userId == request.auth.uid || regId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (isAdminToken() || resource.data.userId == request.auth.uid);
        allow create, update: if isSignedIn() && isValidId(liveClassId) && isValidId(regId) &&
          isValidLiveClassRegistration(incoming()) &&
          incoming().liveClassId == liveClassId &&
          exists(/databases/$(database)/documents/liveClasses/$(liveClassId)) &&
          (incoming().userId == request.auth.uid || isAdmin());
        allow delete: if isAdmin() && isValidId(liveClassId) && isValidId(regId);
      }
    }

    match /liveClassSecrets/{liveClassId} {
      allow get, delete: if isAdmin() && isValidId(liveClassId);
      allow list: if isAdminToken();
      allow create, update: if isAdmin() && isValidId(liveClassId) && isValidLiveClassSecret(incoming());
    }

    // 15. Scoped FCM Device Tokens
    match /fcmTokens/{tokenId} {
      allow get: if isSignedIn() && isValidId(tokenId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdminToken();
      allow create, update: if isSignedIn() && isValidId(tokenId) && isValidFcmToken(incoming()) && (incoming().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(tokenId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 16. Notification Delivery Deduplication Locks (Admin / Server only)
    match /notificationDeliveries/{deliveryId} {
      allow get, delete: if isAdmin() && isValidId(deliveryId);
      allow list: if isAdminToken();
      allow create, update: if isAdmin() && isValidId(deliveryId) && isValidNotificationDelivery(incoming());
    }
  }
}

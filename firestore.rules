rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if user is the administrator
    function isAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email is string && (
          request.auth.token.email.lower() == 'ai.clipzone.edu@gmail.com' ||
          request.auth.token.email.lower() == 'rajababum426@gmail.com' ||
          request.auth.token.email.lower().matches('^admin.*')
        );
    }

    // Security rules for student course access requests
    match /course_requests/{requestId} {
      // Students can view their own requests, admins can view all
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      
      // Any signed-in user can submit their own request
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      
      // Admins can update any request (e.g. approve/decline). 
      // Students can only update if they do not modify the verification status.
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status)
      );
      
      // Only admins can delete requests
      allow delete: if isSignedIn() && isAdmin();
    }

    // Security rules for premium activation/license keys
    match /activation_keys/{code} {
      allow read, write: if true;
    }

    // Security rules for student video progress
    match /user_progress/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    // Security rules for dynamic courses catalog
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Security rules for system configuration & global session resets
    match /system/{doc} {
      allow read, write: if true;
    }

    // Security rules for broadcast push notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Security rules for Ask & Support live conversations and messages
    match /support_conversations/{conversationId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Security rules for course-scoped sub-admin accounts
    match /sub_admins/{code} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Verified course enrollments (managed by backend/Admin, readable by owner/admin)
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // Live class schedule metadata (public-safe, no meeting secrets; validated for backend REST mode)
    match /liveClasses/{classId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'courseId', 'title', 'scheduledStartAt', 'status'])
        && request.resource.data.id is string
        && request.resource.data.courseId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 200
        && request.resource.data.status in ['draft', 'published', 'live', 'completed', 'cancelled'];
      allow delete: if true;

      match /registrations/{registrationId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll(['liveClassId', 'userId', 'courseId', 'status'])
          && request.resource.data.liveClassId is string
          && request.resource.data.userId is string
          && request.resource.data.courseId is string
          && request.resource.data.status in ['registered', 'joined'];
        allow delete: if true;
      }
    }

    // Meeting join credentials (single-doc access for backend REST mode; bulk list restricted to Admin)
    match /liveClassSecrets/{classId} {
      allow list: if isAdmin();
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasAll(['liveClassId', 'zoomMeetingId', 'zoomJoinUrl'])
        && request.resource.data.liveClassId is string
        && request.resource.data.zoomMeetingId is string
        && request.resource.data.zoomJoinUrl is string;
      allow delete: if true;
    }

    // Server/REST-managed FCM device tokens for course-enrolled push notifications
    match /fcmTokens/{tokenId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['token', 'userId', 'enrolledCourseIds'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.userId is string
        && request.resource.data.enrolledCourseIds is list;
      allow delete: if true;
    }

    // Notification deduplication locks (Admin/Backend REST mode)
    match /notificationDeliveries/{deliveryKey} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['deliveryKey', 'liveClassId', 'reminderType'])
        && request.resource.data.deliveryKey is string
        && request.resource.data.liveClassId is string
        && request.resource.data.reminderType in ['published', '30m', '5m', 'manual'];
      allow delete: if true;
    }

    // Global default catch-all: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

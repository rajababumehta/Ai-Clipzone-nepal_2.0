{
  "version": 2,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "aiclipzone.vercel.app"
        }
      ],
      "destination": "https://hamrolms.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots.js"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/llms.js"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/llms.js?full=1"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/assetlinks.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api(?:/|$)|\\.well-known(?:/|$)|robots\\.txt$|sitemap\\.xml$|llms\\.txt$|llms-full\\.txt$|manifest\\.json$|sw\\.js$|firebase-messaging-sw\\.js$|widget-template\\.json$|google[a-zA-Z0-9]+\\.html$|.*\\.(?:png|jpg|jpeg|webp|gif|svg|ico|css|js|woff2?|ttf|json|xml|txt)$).*)",
      "destination": "/api/page.js?__route=/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/live-classes/cron/reminders",
      "schedule": "0 8 * * *"
    }
  ]
}
